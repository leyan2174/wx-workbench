{
  "schema": 1,
  "synthetic_only": true,
  "cases": [
    {
      "name": "boundary-null-transcription-and-shards",
      "existing": {
        "username": "synthetic-user",
        "messages": [
          {
            "local_id": 1,
            "timestamp": 10,
            "source": "a",
            "transcription": "old synthetic voice",
            "custom": {
              "keep": true
            }
          },
          {
            "local_id": 2,
            "timestamp": null,
            "source": "a"
          },
          {
            "local_id": 3,
            "timestamp": 10,
            "source": "a"
          }
        ],
        "custom_root": {
          "old": 1
        }
      },
      "incoming": {
        "username": "synthetic-user",
        "messages": [
          {
            "local_id": 1,
            "timestamp": 10,
            "source": "a",
            "transcription": "replacement"
          },
          {
            "local_id": 1,
            "timestamp": 10,
            "source": "b"
          },
          {
            "local_id": 4,
            "timestamp": 10,
            "source": "a"
          },
          {
            "local_id": 4,
            "timestamp": 10,
            "source": "a"
          },
          {
            "local_id": 5,
            "timestamp": -1,
            "source": "b"
          },
          {
            "local_id": 6,
            "source": "a"
          }
        ],
        "custom_root": {
          "new": 2
        },
        "fresh": true
      },
      "expected": {
        "ok": {
          "document": {
            "username": "synthetic-user",
            "messages": [
              {
                "local_id": 5,
                "timestamp": -1,
                "source": "b"
              },
              {
                "local_id": 2,
                "timestamp": null,
                "source": "a"
              },
              {
                "local_id": 6,
                "source": "a"
              },
              {
                "local_id": 1,
                "timestamp": 10,
                "source": "a",
                "transcription": "old synthetic voice",
                "custom": {
                  "keep": true
                }
              },
              {
                "local_id": 3,
                "timestamp": 10,
                "source": "a"
              },
              {
                "local_id": 1,
                "timestamp": 10,
                "source": "b"
              },
              {
                "local_id": 4,
                "timestamp": 10,
                "source": "a"
              }
            ],
            "custom_root": {
              "old": 1
            },
            "fresh": true
          },
          "report": {
            "added": 4,
            "retained": 3,
            "duplicates": 2,
            "ambiguous": 0
          }
        }
      }
    },
