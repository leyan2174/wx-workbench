        let mut blob = vec![0xAA, 0xBB, 0xCC];
        blob.extend_from_slice(&[0x12, 0x22, 0x0A, 0x20]);
        blob.extend_from_slice(b"deadbeefcafebabe1234567890abcdef");
        blob.extend_from_slice(&[0xFF, 0xFF]);
        assert_eq!(
