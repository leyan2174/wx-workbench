        let mut blob = vec![0xFF, 0x00];
        blob.extend_from_slice(b"00112233445566778899aabbccddeeff");
        blob.extend_from_slice(&[0x01]);
        assert_eq!(
            extract_md5_from_packed_info(&blob),
            Some("00112233445566778899aabbccddeeff".to_string())
        );
    }

